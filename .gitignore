# Monorepo root — applies to learning-app/, gemma-llama/, pre-generated-clips/,
# and shared tooling. Subprojects may add their own .gitignore for paths only
# relevant inside that directory.

# --- Python (all subprojects) ---
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
.venv/
venv/
env/
build/
dist/
pip-wheel-metadata/

# Testing / lint / types
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
.hypothesis/

# --- Local databases (dev / ad-hoc runs) ---
*.sqlite
*.sqlite3

# --- Env & secrets ---
.env
.env.*
!.env.example

# --- Models, weights & heavy caches ---
# ONNX / quantized / GGUF binaries (restore via Docker or download scripts).
*.gguf
*.gguf.*
*.onnx
*.tflite
*.pt
*.pth
*.safetensors

# Hugging Face and similar download caches (large blob trees).
**/.hf-cache/

# Subproject conventions: whole trees that only hold downloads or generated outputs.
gemma-llama/models/
gemma-llama/voices/
gemma-llama/tts_outputs/

# pre-generated-clips caches model blobs under models/ but keeps *.onnx.json etc.
pre-generated-clips/models/.hf-cache/

# Scripted TTS outputs (see pre-generated-clips/README.md).
pre-generated-clips/clips/

# Generated playground preset media for gemma-llama. The manifest + READMEs
# are tracked; the raw WAV/JPG assets stay local because they can be
# regenerated via `make presets` in pre-generated-clips/ (audio) or sourced
# manually (4 vision-teach images). See gemma-llama/.gitignore for the
# per-folder patterns -- the nested .gitignore owns this subtree so the
# rules live next to the data.

# --- Docker ---
docker-compose.override.yml
**/docker-compose.override.yml

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

spec-new.md