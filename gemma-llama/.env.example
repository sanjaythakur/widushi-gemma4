# ============================================================================
# gemma-llama environment configuration
# ----------------------------------------------------------------------------
# Copy to `.env` and adjust values for your host. Defaults below are tuned for
# Raspberry Pi 5 (16 GB) production. Comments include macOS dev overrides.
# ============================================================================

# ---- API ------------------------------------------------------------------
# Host port the FastAPI service is exposed on (container always listens 8000).
API_PORT=8010
LOG_LEVEL=info

# ---- Model selection ------------------------------------------------------
# Selects the active YAML config inside the api container.
#   model_configs/gemma4-e4b.yaml      (default, vision + audio, fits Pi 5 16GB)
#   model_configs/gemma4-e2b.yaml      (lighter, also vision + audio)
#   model_configs/gemma4-26b-a4b.yaml  (needs >= 32 GB RAM)
#   model_configs/gemma4-31b.yaml      (needs >= 48 GB RAM, GPU recommended)
MODEL_CONFIG_PATH=model_configs/gemma4-e4b.yaml

# Hugging Face GGUF source. These are read by the llama container's
# download_model.sh on first boot. Override to point at a different mirror
# (e.g. bartowski/...) if the default repo is unavailable.
#
# Defaults: Gemma 4 E4B (4B effective params). The April 2026 Gemma 4 release
# from Google ships official GGUFs via Unsloth, including the official Google
# vision/audio projector in the same repo as the model weights.
#
# NOTE: HF filenames are case-sensitive. Use uppercase E4B / E2B / A4B / B
# exactly as written below; lowercase variants will 404.
MODEL_REPO=unsloth/gemma-4-E4B-it-GGUF
MODEL_FILE=gemma-4-E4B-it-Q4_K_M.gguf

# Vision + audio projector (mmproj). Required for /vision, /audio, /video.
#
# As of the April 2026 release, the official Google projector ships inside
# the unsloth/gemma-4-* GGUF repos. We default to the BF16 build for the best
# accuracy/size trade-off on Pi 5; mmproj-F16.gguf and mmproj-F32.gguf are
# also available in the same repo if you need to match a specific runtime.
MMPROJ_REPO=unsloth/gemma-4-E4B-it-GGUF
MMPROJ_FILE=mmproj-BF16.gguf

# Optional: Hugging Face token (required for gated repos).
HF_TOKEN=

# ---- llama.cpp runtime ----------------------------------------------------
# Context window in tokens.
CONTEXT_SIZE=8192

# CPU threads. Pi 5 has 4 physical cores. On macOS dev, bump to your core count
# (e.g. 8 on M-series).
THREADS=4
# THREADS=8   # uncomment for macOS dev

# GPU layers offloaded. 0 = CPU only (Pi 5, macOS-in-Docker).
# Use docker-compose.gpu.yml to flip this to 99 on CUDA hosts.
GPU_LAYERS=0

# ---- llama.cpp source pin -------------------------------------------------
# Build-time pin for the llama.cpp git ref. We default to a tag from after
# the early-April 2026 native Gemma 4 audio merge so that audio + video work
# out of the box. Bump to any newer tag from
#   https://github.com/ggml-org/llama.cpp/tags
# This is consumed by docker/Dockerfile.llama as a build arg, so a change
# requires `docker compose build llama` (or `up --build`).
LLAMA_CPP_REF=b8837

# Keep the mmproj projector on CPU when GPU_LAYERS=0. Setting this to "true"
# only makes sense when you also have a CUDA/Metal backend with spare VRAM.
MMPROJ_USE_GPU=false

# ---- API -> llama adapter -------------------------------------------------
LLAMA_SERVER_URL=http://llama:8080
# 1800 s = 30 min. Multimodal prompts on Pi 5 routinely take 5-15 min to
# encode (each video frame is ~75 s through the vision projector on CPU)
# before the first token is decoded. Lower at your own risk; on a CUDA host
# you can drop this to 120 or so.
LLM_TIMEOUT_SECONDS=1800
# Retries are skipped automatically on httpx timeouts (retrying would just
# cancel the in-flight task on llama.cpp and restart the prompt encode from
# zero). Keep at 3 for transient network / 5xx hiccups.
LLM_RETRIES=3

# ---- TTS (Piper) ----------------------------------------------------------
# Master switch. Set to "false" to fully disable the TTS subsystem (the
# `tts=true` flag on every endpoint will then be ignored, and the /tts/*
# routes return 503).
TTS_ENABLED=true

# Path to the Piper binary inside the api container. Default matches what
# docker/Dockerfile.api installs from rhasspy/piper releases.
PIPER_BINARY=/usr/local/bin/piper

# Where the downloaded .onnx voices live (volume-mounted ./voices:/voices).
TTS_VOICES_DIR=/voices

# Scratch dir for the long-output `audio_url` shape. Files are evicted after
# TTS_OUTPUT_TTL_SECONDS so the dir does not grow without bound.
TTS_OUTPUT_DIR=/tmp/tts_outputs
TTS_OUTPUT_TTL_SECONDS=600

# Default voice "personality" used when callers omit `voice`. The id must
# resolve in app/tts/voices.py PERSONALITIES.
TTS_DEFAULT_VOICE=warm-academic

# Comma-separated personality ids to download at api container startup.
# Trim to shorten cold-start (each voice is ~20-60 MiB).
TTS_VOICES_ENABLED=warm-academic,friendly-casual,neutral-news,energetic-kid,calm-storyteller

# Hard-flush threshold for the streaming sentence buffer (chars). Output
# without punctuation is still spoken in bounded time at this cap.
TTS_MAX_SENTENCE_CHARS=400

# Cap on concurrent Piper subprocesses. Pi 5 has 4 cores; 2 leaves headroom
# for llama.cpp.
TTS_MAX_CONCURRENCY=2
