# syntax=docker/dockerfile:1.6
# ============================================================================
# Multi-stage build for llama.cpp llama-server.
#   Stage 1 (builder): clones llama.cpp and compiles llama-server.
#   Stage 2 (runtime): minimal Ubuntu image with binary + huggingface_hub.
# Build args:
#   GGML_CUDA=ON  -> link CUDA backend (used by docker-compose.gpu.yml)
#   LLAMA_CPP_REF -> override llama.cpp git ref (default: master)
# ============================================================================

ARG GGML_CUDA=OFF
# Pinned to a tagged llama.cpp build that ships the April 2026 native Gemma 4
# audio path (mtmd + the unified vision/audio mmproj). Override via build arg
# or .env to bump (any tag from https://github.com/ggml-org/llama.cpp/tags
# from after the early-April 2026 merge will do).
ARG LLAMA_CPP_REF=b8837

# Optional explicit ARM CPU baseline. On Pi 5 (Cortex-A76) we want
# `armv8.2-a+dotprod+i8mm+fp16` so llama.cpp emits the i8mm-accelerated SGEMM
# kernels (~30-50% faster Q4_0 matmul vs. the dotprod-only baseline). Empty by
# default; the builder stage auto-fills it for arm64 image builds. Override at
# build time (`docker build --build-arg GGML_CPU_ARM_ARCH=armv8.2-a+dotprod`)
# to disable i8mm if your toolchain miscompiles those kernels.
ARG GGML_CPU_ARM_ARCH=""

# ----------------------------- Builder stage --------------------------------
FROM ubuntu:22.04 AS builder

ARG GGML_CUDA
ARG LLAMA_CPP_REF
ARG GGML_CPU_ARM_ARCH
# BuildKit-provided; "amd64" / "arm64" / etc.
ARG TARGETARCH=""
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        ca-certificates \
        libcurl4-openssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# Try the pinned tag first; fall back to a full clone if the tag has been GC'd
# upstream so dev iteration doesn't hard-fail. The subsequent checkout step
# either re-pins to ${LLAMA_CPP_REF} or stays on master.
RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp.git \
    || git clone https://github.com/ggml-org/llama.cpp.git

WORKDIR /src/llama.cpp
RUN if [ "${LLAMA_CPP_REF}" != "master" ]; then \
        git fetch --depth 1 origin "${LLAMA_CPP_REF}" && git checkout "${LLAMA_CPP_REF}"; \
    fi
RUN git rev-parse HEAD > /llama.cpp.sha && \
    echo "llama.cpp built at $(cat /llama.cpp.sha) (ref=${LLAMA_CPP_REF})"

# Resolve the effective ARM CPU baseline: explicit build arg wins; otherwise
# auto-fill on arm64 hosts (Pi 5 / Apple-silicon Linux containers) so the i8mm
# matmul kernels are emitted. x86 builds leave this empty so cmake keeps its
# native auto-detection.
RUN set -eux; \
    EFFECTIVE_ARM_ARCH="${GGML_CPU_ARM_ARCH}"; \
    if [ -z "$EFFECTIVE_ARM_ARCH" ] && [ "${TARGETARCH}" = "arm64" ]; then \
        EFFECTIVE_ARM_ARCH="armv8.2-a+dotprod+i8mm+fp16"; \
    fi; \
    EXTRA_CMAKE_ARGS=""; \
    if [ -n "$EFFECTIVE_ARM_ARCH" ]; then \
        EXTRA_CMAKE_ARGS="-DGGML_CPU_ARM_ARCH=${EFFECTIVE_ARM_ARCH}"; \
        echo "llama.cpp ARM CPU baseline: ${EFFECTIVE_ARM_ARCH}"; \
    else \
        echo "llama.cpp ARM CPU baseline: (default / native auto-detect)"; \
    fi; \
    cmake -B build \
        -DGGML_CUDA=${GGML_CUDA} \
        -DLLAMA_CURL=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_BUILD_TYPE=Release \
        ${EXTRA_CMAKE_ARGS} \
    && cmake --build build --config Release -j"$(nproc)" --target llama-server

# Stage all artifacts we need to copy into runtime in one place.
RUN mkdir -p /out/bin /out/lib \
    && cp build/bin/llama-server /out/bin/ \
    && find build -name '*.so' -exec cp -L {} /out/lib/ \;

# ----------------------------- Runtime stage --------------------------------
FROM ubuntu:22.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libcurl4 \
        libgomp1 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir 'huggingface_hub[cli]>=0.26'

COPY --from=builder /out/bin/llama-server /usr/local/bin/llama-server
COPY --from=builder /out/lib/ /usr/local/lib/
RUN ldconfig

COPY docker/download_model.sh /usr/local/bin/download_model.sh
RUN chmod +x /usr/local/bin/download_model.sh

# Defaults; overridden by docker-compose env.
ENV MODEL_DIR=/models \
    MODEL_PATH=/models/model.gguf \
    MMPROJ_PATH=/models/mmproj.gguf \
    DRAFT_PATH=/models/draft.gguf \
    HOST=0.0.0.0 \
    PORT=8080 \
    CONTEXT_SIZE=8192 \
    THREADS=4 \
    THREADS_BATCH= \
    BATCH_SIZE=2048 \
    UBATCH_SIZE=512 \
    GPU_LAYERS=0 \
    MMPROJ_USE_GPU=false \
    FLASH_ATTN=true \
    CACHE_TYPE_K=q8_0 \
    CACHE_TYPE_V=q8_0 \
    MLOCK=true \
    DRAFT_MAX=8 \
    DRAFT_MIN=4 \
    DRAFT_P_MIN=0.75

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=10s --start-period=3600s --retries=5 \
    CMD curl -fsS "http://localhost:${PORT}/health" || exit 1

# download_model.sh is idempotent: skips download if files exist.
# `--jinja` ensures the Gemma chat template handles system messages and tools.
# `--mmproj` is only added when MMPROJ_PATH points to an existing file. The
# unified Gemma 4 mmproj GGUF carries BOTH the vision and audio adapters, so
# this single flag enables /vision/*, /audio/*, and /video/* end-to-end. The
# repo ships F16 / BF16 / F32 builds; we default to F16 because Pi 5 has no
# native BF16 (see .env.example for the full rationale).
# `--no-mmproj-offload` keeps the projector resident on CPU when MMPROJ_USE_GPU
# is anything other than "true" -- correct default for Pi 5 / CPU-only Macs.
#
# `-fa` (flash attention) plus `--cache-type-k/v q8_0` halves KV-cache memory
# bandwidth, which is the dominant decode-time cost on Pi 5 (memory-bandwidth
# bound, not compute bound). Typical win: 20-40% faster decode at 8k ctx with
# no measurable quality loss. llama.cpp requires `-fa` whenever the V-cache is
# anything other than f16, so we silently drop CACHE_TYPE_V back to the
# default if FLASH_ATTN is disabled, rather than refusing to boot.
#
# Batch tuning (`-b`/`-ub`) controls prompt-processing parallelism. The Pi 5
# defaults below (b=2048, ub=512) match llama.cpp upstream and balance prefill
# throughput against L2-cache thrash on Cortex-A76. Drop ub to 256 if your
# multimodal prefill saturates the cache; bump b to 4096 on hosts with a GPU.
# `--threads-batch` decouples prompt-eval thread count from decode threads;
# Pi 5 is happiest using all 4 cores for both phases (default falls back to
# THREADS when THREADS_BATCH is empty).
#
# Draft / speculative decoding (`-md` / `--draft-*`) is OFF by default for
# Gemma 4 E4B because no compatible draft model exists in stock llama.cpp at
# the pinned ref:
#   * google/gemma-4-E4B-it-assistant (the official 78M MTP drafter) needs
#     the atomic-llama-cpp-turboquant fork (custom `gemma4_assistant` arch).
#   * Using gemma-4-E2B-it as a draft is blocked by ggml-org/llama.cpp#22337
#     (per-layer tensor metadata mismatch with E4B/31B targets).
#   * gemma-3-270m-it has the wrong tokenizer (Gemma 3 SPM vs Gemma 4 BPE).
# The plumbing below is wired so flipping DRAFT_REPO/DRAFT_FILE in `.env`
# enables it the moment a compatible draft lands upstream.
#
# IMPORTANT: leading `set -e` so a non-zero exit from download_model.sh aborts
# the container immediately (otherwise `;` separators below would fall through
# to `exec llama-server` and load a missing/stale model).
CMD ["/bin/bash", "-eo", "pipefail", "-c", "\
    /usr/local/bin/download_model.sh; \
    MMPROJ_FLAG=''; \
    if [ -f \"$MMPROJ_PATH\" ]; then \
        MMPROJ_FLAG=\"--mmproj $MMPROJ_PATH\"; \
        MMPROJ_USE_GPU_LC=$(printf '%s' \"$MMPROJ_USE_GPU\" | tr '[:upper:]' '[:lower:]'); \
        case \"$MMPROJ_USE_GPU_LC\" in \
            true|1|yes|on) ;; \
            *) MMPROJ_FLAG=\"$MMPROJ_FLAG --no-mmproj-offload\" ;; \
        esac; \
    fi; \
    FLASH_ATTN_LC=$(printf '%s' \"$FLASH_ATTN\" | tr '[:upper:]' '[:lower:]'); \
    FA_ON=0; \
    FA_FLAG=''; \
    case \"$FLASH_ATTN_LC\" in \
        true|1|yes|on) FA_FLAG='--flash-attn on'; FA_ON=1 ;; \
        false|0|no|off) FA_FLAG='--flash-attn off' ;; \
        auto|'') FA_FLAG='--flash-attn auto' ;; \
        *) FA_FLAG=\"--flash-attn $FLASH_ATTN_LC\" ;; \
    esac; \
    KV_FLAGS=''; \
    if [ -n \"$CACHE_TYPE_K\" ]; then \
        KV_FLAGS=\"--cache-type-k $CACHE_TYPE_K\"; \
    fi; \
    if [ \"$FA_ON\" = '1' ] && [ -n \"$CACHE_TYPE_V\" ]; then \
        KV_FLAGS=\"$KV_FLAGS --cache-type-v $CACHE_TYPE_V\"; \
    elif [ \"$FA_ON\" != '1' ] && [ -n \"$CACHE_TYPE_V\" ] && [ \"$CACHE_TYPE_V\" != \"f16\" ]; then \
        echo \"[llama] FLASH_ATTN is not 'on'; ignoring CACHE_TYPE_V=$CACHE_TYPE_V (llama.cpp requires -fa on for non-f16 V-cache).\" 1>&2; \
    fi; \
    MLOCK_LC=$(printf '%s' \"$MLOCK\" | tr '[:upper:]' '[:lower:]'); \
    MLOCK_FLAG=''; \
    case \"$MLOCK_LC\" in \
        true|1|yes|on) MLOCK_FLAG='--mlock' ;; \
    esac; \
    BATCH_FLAGS=''; \
    if [ -n \"$BATCH_SIZE\" ]; then \
        BATCH_FLAGS=\"-b $BATCH_SIZE\"; \
    fi; \
    if [ -n \"$UBATCH_SIZE\" ]; then \
        BATCH_FLAGS=\"$BATCH_FLAGS -ub $UBATCH_SIZE\"; \
    fi; \
    if [ -n \"$THREADS_BATCH\" ]; then \
        BATCH_FLAGS=\"$BATCH_FLAGS -tb $THREADS_BATCH\"; \
    fi; \
    DRAFT_FLAGS=''; \
    if [ -f \"$DRAFT_PATH\" ]; then \
        DRAFT_FLAGS=\"-md $DRAFT_PATH\"; \
        if [ -n \"$DRAFT_MAX\" ];   then DRAFT_FLAGS=\"$DRAFT_FLAGS --draft-max $DRAFT_MAX\"; fi; \
        if [ -n \"$DRAFT_MIN\" ];   then DRAFT_FLAGS=\"$DRAFT_FLAGS --draft-min $DRAFT_MIN\"; fi; \
        if [ -n \"$DRAFT_P_MIN\" ]; then DRAFT_FLAGS=\"$DRAFT_FLAGS --draft-p-min $DRAFT_P_MIN\"; fi; \
        echo \"[llama] speculative decoding ENABLED with draft=$DRAFT_PATH (max=$DRAFT_MAX min=$DRAFT_MIN p_min=$DRAFT_P_MIN)\" 1>&2; \
    fi; \
    exec llama-server \
        -m \"$MODEL_PATH\" \
        $MMPROJ_FLAG \
        --host \"$HOST\" \
        --port \"$PORT\" \
        -c \"$CONTEXT_SIZE\" \
        -t \"$THREADS\" \
        -ngl \"$GPU_LAYERS\" \
        $BATCH_FLAGS \
        $FA_FLAG \
        $KV_FLAGS \
        $MLOCK_FLAG \
        $DRAFT_FLAGS \
        --jinja \
"]
