# syntax=docker/dockerfile:1.6
# ============================================================================
# Multi-stage build for llama.cpp llama-server.
#   Stage 1 (builder): clones llama.cpp and compiles llama-server.
#   Stage 2 (runtime): minimal Ubuntu image with binary + huggingface_hub.
# Build args:
#   GGML_CUDA=ON  -> link CUDA backend (used by docker-compose.gpu.yml)
#   LLAMA_CPP_REF -> override llama.cpp git ref (default: master)
# ============================================================================

ARG GGML_CUDA=OFF
# Pinned to a tagged llama.cpp build that ships the April 2026 native Gemma 4
# audio path (mtmd + the unified vision/audio mmproj). Override via build arg
# or .env to bump (any tag from https://github.com/ggml-org/llama.cpp/tags
# from after the early-April 2026 merge will do).
ARG LLAMA_CPP_REF=b8837

# ----------------------------- Builder stage --------------------------------
FROM ubuntu:22.04 AS builder

ARG GGML_CUDA
ARG LLAMA_CPP_REF
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        git \
        ca-certificates \
        libcurl4-openssl-dev \
        pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
# Try the pinned tag first; fall back to a full clone if the tag has been GC'd
# upstream so dev iteration doesn't hard-fail. The subsequent checkout step
# either re-pins to ${LLAMA_CPP_REF} or stays on master.
RUN git clone --depth 1 --branch "${LLAMA_CPP_REF}" https://github.com/ggml-org/llama.cpp.git \
    || git clone https://github.com/ggml-org/llama.cpp.git

WORKDIR /src/llama.cpp
RUN if [ "${LLAMA_CPP_REF}" != "master" ]; then \
        git fetch --depth 1 origin "${LLAMA_CPP_REF}" && git checkout "${LLAMA_CPP_REF}"; \
    fi
RUN git rev-parse HEAD > /llama.cpp.sha && \
    echo "llama.cpp built at $(cat /llama.cpp.sha) (ref=${LLAMA_CPP_REF})"

RUN cmake -B build \
        -DGGML_CUDA=${GGML_CUDA} \
        -DLLAMA_CURL=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release -j"$(nproc)" --target llama-server

# Stage all artifacts we need to copy into runtime in one place.
RUN mkdir -p /out/bin /out/lib \
    && cp build/bin/llama-server /out/bin/ \
    && find build -name '*.so' -exec cp -L {} /out/lib/ \;

# ----------------------------- Runtime stage --------------------------------
FROM ubuntu:22.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libcurl4 \
        libgomp1 \
        python3 \
        python3-pip \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir 'huggingface_hub[cli]>=0.26'

COPY --from=builder /out/bin/llama-server /usr/local/bin/llama-server
COPY --from=builder /out/lib/ /usr/local/lib/
RUN ldconfig

COPY docker/download_model.sh /usr/local/bin/download_model.sh
RUN chmod +x /usr/local/bin/download_model.sh

# Defaults; overridden by docker-compose env.
ENV MODEL_DIR=/models \
    MODEL_PATH=/models/model.gguf \
    MMPROJ_PATH=/models/mmproj.gguf \
    HOST=0.0.0.0 \
    PORT=8080 \
    CONTEXT_SIZE=8192 \
    THREADS=4 \
    GPU_LAYERS=0 \
    MMPROJ_USE_GPU=false

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=10s --start-period=3600s --retries=5 \
    CMD curl -fsS "http://localhost:${PORT}/health" || exit 1

# download_model.sh is idempotent: skips download if files exist.
# `--jinja` ensures the Gemma chat template handles system messages and tools.
# `--mmproj` is only added when MMPROJ_PATH points to an existing file. The
# unified Gemma 4 mmproj-BF16.gguf carries BOTH the vision and audio adapters,
# so this single flag enables /vision/*, /audio/*, and /video/* end-to-end.
# `--no-mmproj-offload` keeps the projector resident on CPU when MMPROJ_USE_GPU
# is anything other than "true" -- correct default for Pi 5 / CPU-only Macs.
#
# IMPORTANT: leading `set -e` so a non-zero exit from download_model.sh aborts
# the container immediately (otherwise `;` separators below would fall through
# to `exec llama-server` and load a missing/stale model).
CMD ["/bin/bash", "-eo", "pipefail", "-c", "\
    /usr/local/bin/download_model.sh; \
    MMPROJ_FLAG=''; \
    if [ -f \"$MMPROJ_PATH\" ]; then \
        MMPROJ_FLAG=\"--mmproj $MMPROJ_PATH\"; \
        MMPROJ_USE_GPU_LC=$(printf '%s' \"$MMPROJ_USE_GPU\" | tr '[:upper:]' '[:lower:]'); \
        case \"$MMPROJ_USE_GPU_LC\" in \
            true|1|yes|on) ;; \
            *) MMPROJ_FLAG=\"$MMPROJ_FLAG --no-mmproj-offload\" ;; \
        esac; \
    fi; \
    exec llama-server \
        -m \"$MODEL_PATH\" \
        $MMPROJ_FLAG \
        --host \"$HOST\" \
        --port \"$PORT\" \
        -c \"$CONTEXT_SIZE\" \
        -t \"$THREADS\" \
        -ngl \"$GPU_LAYERS\" \
        --jinja \
"]
